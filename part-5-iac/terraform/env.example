# Environment Variables for Terraform
# Copy this file to .env and set your values
# DO NOT commit .env to version control!

# RDS PostgreSQL Master Password
# Leave unset to auto-generate a secure password
# If set, must be at least 8 characters
export TF_VAR_rds_password=""

# Application JWT Secret Key
# Required if you want Terraform to create the secret in Secrets Manager
# Should be a strong, random string (recommended: 32+ characters)
export TF_VAR_jwt_secret_key=""

# Optional: AWS Profile
export AWS_PROFILE="titanic-api-prod"

# Usage:
# 1. Copy this file: cp env.example .env
# 2. Edit .env with your values (DO NOT commit .env to git)
# 3. Source it before running terraform: source .env
# 4. Run terraform commands
