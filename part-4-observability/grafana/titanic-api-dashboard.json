{
  "dashboard": {
    "title": "Titanic API Overview",
    "tags": ["titanic-api", "monitoring"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Request Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(titanic_api_http_requests_total[5m])) by (method, exported_endpoint)",
            "legendFormat": "{{method}} {{exported_endpoint}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Requests/sec"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time"},
        "legend": {"show": true}
      },
      {
        "id": 2,
        "title": "Request Latency (P50, P95, P99)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(titanic_api_http_request_duration_seconds_bucket[5m])) by (le, exported_endpoint))",
            "legendFormat": "P50 - {{exported_endpoint}}",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(titanic_api_http_request_duration_seconds_bucket[5m])) by (le, exported_endpoint))",
            "legendFormat": "P95 - {{exported_endpoint}}",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(titanic_api_http_request_duration_seconds_bucket[5m])) by (le, exported_endpoint))",
            "legendFormat": "P99 - {{exported_endpoint}}",
            "refId": "C"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Latency"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time"},
        "legend": {"show": true}
      },
      {
        "id": 3,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "sum(rate(titanic_api_http_requests_total{status=~\"4..\"}[5m])) by (exported_endpoint)",
            "legendFormat": "4xx - {{exported_endpoint}}",
            "refId": "A"
          },
          {
            "expr": "sum(rate(titanic_api_http_requests_total{status=~\"5..\"}[5m])) by (exported_endpoint)",
            "legendFormat": "5xx - {{exported_endpoint}}",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Errors/sec"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time"},
        "legend": {"show": true}
      },
      {
        "id": 4,
        "title": "Resource Utilization",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{pod=~\"titanic-api.*\", container!=\"POD\"}[5m])",
            "legendFormat": "CPU Usage - {{pod}}",
            "refId": "A"
          },
          {
            "expr": "container_memory_usage_bytes{pod=~\"titanic-api.*\", container!=\"POD\"} / 1024 / 1024",
            "legendFormat": "Memory Usage (MB) - {{pod}}",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "CPU (cores)"},
          {"format": "mbytes", "label": "Memory (MB)"}
        ],
        "xaxis": {"mode": "time"},
        "legend": {"show": true}
      }
    ],
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
  }
}
